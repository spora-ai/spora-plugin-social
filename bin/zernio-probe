#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * The Zernio probe: what the API actually answers, redacted.
 *
 * There is no sandbox. Every shape this plugin has to parse — the account
 * object, the create-post response, the analytics response — has to come from
 * a real call, and the call has to be made with a real key by the operator.
 * This script makes that one call and writes down what came back.
 *
 * **The redacted files are the fixtures.** The plugin's tests never talk to
 * Zernio: they run against a mocked HTTP client, and the mock answers with
 * what this script recorded. So the redacted output is what goes into the
 * repository, and it has to keep the shape — every key, every type, every
 * nesting — while carrying nothing of the operator's.
 *
 * The redaction maps an id to `id_001`, a name to `name_001`, and a URL to
 * its host with the path redacted. The same input always maps to the same
 * output, so the fixtures are stable.
 *
 * The raw responses are written next to the redacted ones and are **not** for
 * committing. `build/` is gitignored; delete that directory when you are done.
 *
 * Usage:
 *
 *   php bin/zernio-probe --key=sk_… [--publish-to=<accountId>] [--network=bluesky]
 *   ZERNIO_API_KEY=sk_… php bin/zernio-probe
 */

use Symfony\Component\HttpClient\HttpClient;

require __DIR__ . '/../vendor/autoload.php';

$root = dirname(__DIR__);

chdir($root);

const DEFAULT_BASE_URL = 'https://zernio.com/api/v1';

const PROBE_CONTENT = 'Spora probe post. Safe to delete.';

/**
 * The probe's own options, read once.
 *
 * @return array{key: string, baseUrl: string, out: string, publishTo: string, network: string, content: string}
 */
function probeOptions(array $argv): array
{
    $options = [
        'key'       => (string) (getenv('ZERNIO_API_KEY') ?: ''),
        'baseUrl'   => (string) (getenv('ZERNIO_BASE_URL') ?: DEFAULT_BASE_URL),
        'out'       => 'build/zernio-probe',
        'publishTo' => '',
        'network'   => '',
        'content'   => PROBE_CONTENT,
    ];

    foreach (array_slice($argv, 1) as $argument) {
        if (!str_starts_with($argument, '--')) {
            continue;
        }

        $pair = explode('=', substr($argument, 2), 2);
        $name = $pair[0];
        $value = $pair[1] ?? '';

        if (array_key_exists($name, $options)) {
            $options[$name] = $value;
        }
    }

    return $options;
}

/**
 * One call, and what it answered.
 *
 * @param array<string, mixed> $query
 * @param array<string, mixed> $body
 * @return array{status: int, body: array<string, mixed>, raw: string}
 */
function zernioCall(
    \Symfony\Contracts\HttpClient\HttpClientInterface $client,
    string $method,
    string $path,
    string $key,
    string $baseUrl,
    array $query = [],
    array $body = [],
    array $headers = [],
): array {
    $url = rtrim($baseUrl, '/') . '/' . ltrim($path, '/');

    $options = [
        'headers' => array_merge([
            'Authorization' => 'Bearer ' . $key,
            'Accept'        => 'application/json',
        ], $headers),
    ];

    if ($query !== []) {
        $options['query'] = $query;
    }

    if ($body !== []) {
        $options['json'] = $body;
    }

    $response = $client->request($method, $url, $options);
    $status = $response->getStatusCode();
    $raw = $response->getContent(false);

    $decoded = json_decode($raw, true);

    return [
        'status' => $status,
        'body'   => is_array($decoded) ? $decoded : [],
        'raw'    => $raw,
    ];
}

/**
 * The account the probe publishes to.
 *
 * @param list<array<string, mixed>> $accounts
 * @return array<string, mixed>|null
 */
function pickAccount(array $accounts, string $accountId, string $network): ?array
{
    foreach ($accounts as $account) {
        if ($accountId !== '' && (string) ($account['_id'] ?? '') === $accountId) {
            return $account;
        }
    }

    if ($network === '') {
        return null;
    }

    foreach ($accounts as $account) {
        if (strtolower((string) ($account['platform'] ?? '')) === strtolower($network)) {
            return $account;
        }
    }

    return null;
}

/**
 * Every value that identifies something, and the placeholder it becomes.
 *
 * The categories are coarse on purpose: an id looks like an id, a name like a
 * name, and a URL keeps its host. What the fixtures need is the *shape*, not
 * the value.
 *
 * @param list<array<string, mixed>> $sources
 * @return array<string, string>
 */
function redactionMap(array $sources): array
{
    $map = [];
    $idCounter = 0;
    $nameCounter = 0;

    $visit = function (mixed $value, string $key) use (&$visit, &$map, &$idCounter, &$nameCounter): void {
        if (is_array($value)) {
            foreach ($value as $childKey => $child) {
                $visit($child, is_string($childKey) ? $childKey : $key);
            }

            return;
        }

        if (!is_string($value) || $value === '') {
            return;
        }

        if (str_contains($value, '://')) {
            // A URL keeps its host — it is public — and loses its path.
            $host = (string) (parse_url($value, PHP_URL_HOST) ?: 'example.test');
            $map[$value] = 'https://' . $host . '/redacted';

            return;
        }

        if (preg_match('/^[0-9a-f]{24}$/i', $value) === 1) {
            $idCounter++;
            $map[$value] = sprintf('id_%03d', $idCounter);

            return;
        }

        $nameKeys = ['displayName', 'username', 'name', 'display_name', 'firstName', 'lastName', 'fullName'];

        if (in_array($key, $nameKeys, true)) {
            $nameCounter++;
            $map[$value] = sprintf('name_%03d', $nameCounter);
        }
    };

    foreach ($sources as $source) {
        $visit($source, '');
    }

    return $map;
}

/**
 * The same tree, with every identifying value replaced.
 *
 * @param array<string, mixed> $source
 * @param array<string, string> $map
 * @return array<string, mixed>
 */
function redact(array $source, array $map): array
{
    $walk = function (mixed $value) use (&$walk, $map): mixed {
        if (is_array($value)) {
            $out = [];

            foreach ($value as $key => $child) {
                $out[$key] = $walk($child);
            }

            return $out;
        }

        if (!is_string($value) || $value === '') {
            return $value;
        }

        if (isset($map[$value])) {
            return $map[$value];
        }

        // A URL that embeds an id or a name keeps its shape but loses them.
        foreach ($map as $from => $to) {
            if (strlen($from) > 2 && str_contains($value, $from)) {
                $value = str_replace($from, $to, $value);
            }
        }

        return $value;
    };

    return $walk($source);
}

/**
 * Write a fixture and its raw counterpart.
 *
 * @param array<string, mixed> $body
 * @param array<string, string> $map
 */
function writeFixture(string $out, string $name, array $body, array $map): void
{
    $rawDir = $out . '/raw';
    $redactedDir = $out . '/redacted';

    foreach ([$rawDir, $redactedDir] as $dir) {
        if (!is_dir($dir) && !mkdir($dir, 0o755, true) && !is_dir($dir)) {
            throw new RuntimeException('Could not create ' . $dir);
        }
    }

    $encoded = json_encode($body, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);

    file_put_contents($rawDir . '/' . $name . '.json', (string) $encoded . "\n");
    file_put_contents($redactedDir . '/' . $name . '.json', (string) json_encode(
        redact($body, $map),
        JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE,
    ) . "\n");

    echo '  wrote ' . $redactedDir . '/' . $name . ".json\n";
}

$options = probeOptions($argv);

echo "\n";
echo "  Spora social — the Zernio probe\n";
echo "\n";

if ($options['key'] === '') {
    echo "  No API key. Pass --key=… or set ZERNIO_API_KEY.\n\n";
    exit(1);
}

echo '  Base URL: ' . $options['baseUrl'] . "\n";
echo '  Output:   ' . $options['out'] . "\n";
echo "\n";

$client = HttpClient::create(['timeout' => 60]);

// The accounts. Everything else is keyed off them.
$accountsResponse = zernioCall(
    $client,
    'GET',
    '/accounts',
    $options['key'],
    $options['baseUrl'],
    ['category' => 'social'],
);

if ($accountsResponse['status'] === 401) {
    echo "  Zernio refused the key (401). Check it in your Zernio dashboard.\n\n";
    exit(1);
}

if ($accountsResponse['status'] >= 400) {
    echo '  Zernio answered ' . $accountsResponse['status'] . " for the accounts list.\n";
    echo '  ' . substr($accountsResponse['raw'], 0, 500) . "\n\n";
    exit(1);
}

$accounts = array_values(array_filter(
    is_array($accountsResponse['body']['accounts'] ?? null) ? $accountsResponse['body']['accounts'] : [],
    'is_array',
));

echo '  Accounts: ' . count($accounts) . "\n";

$platforms = [];

foreach ($accounts as $account) {
    $platforms[(string) ($account['platform'] ?? '?')] = true;
}

if ($platforms !== []) {
    echo '  Platforms: ' . implode(', ', array_keys($platforms)) . "\n";
}

echo "\n";

// What an account carries. The follower count is the open question: it may
// ride on the object or have to be fetched.
$first = $accounts[0] ?? null;

if ($first !== null) {
    echo '  An account carries: ' . implode(', ', array_keys($first)) . "\n";
    echo '  …and a follower count: ' . (array_key_exists('followers', $first) ? 'yes' : 'no') . "\n\n";
}

$map = redactionMap([$accountsResponse['body']]);

writeFixture($options['out'], 'accounts', $accountsResponse['body'], $map);

// The health of one account.
$healthAccount = pickAccount($accounts, $options['publishTo'], $options['network']) ?? $first;

if ($healthAccount !== null) {
    $healthResponse = zernioCall(
        $client,
        'GET',
        '/accounts/' . rawurlencode((string) $healthAccount['_id']) . '/health',
        $options['key'],
        $options['baseUrl'],
    );

    echo '  Health: ' . $healthResponse['status'] . "\n";

    $healthMap = redactionMap([$healthResponse['body']]);
    writeFixture($options['out'], 'account-health', $healthResponse['body'], $healthMap);
}

// The follower stats. It answers 402 without the analytics add-on, which is a
// shape worth having in the fixtures too.
if ($healthAccount !== null) {
    $followerResponse = zernioCall(
        $client,
        'GET',
        '/accounts/follower-stats',
        $options['key'],
        $options['baseUrl'],
        ['accountId' => (string) $healthAccount['_id']],
    );

    echo '  Follower stats: ' . $followerResponse['status'] . "\n";

    $followerMap = redactionMap([$followerResponse['body']]);
    writeFixture($options['out'], 'follower-stats', $followerResponse['body'], $followerMap);
}

// A real publish. This is the one that costs something and puts a post on a
// network, so it only happens when the operator names an account.
$postResponse = null;
$postId = '';

if ($options['publishTo'] !== '' || $options['network'] !== '') {
    $target = pickAccount($accounts, $options['publishTo'], $options['network']);

    if ($target === null) {
        echo "\n  No account matched --publish-to=" . $options['publishTo']
            . ' --network=' . $options['network'] . ". Nothing was published.\n\n";
    } else {
        $platform = (string) ($target['platform'] ?? '');
        $postId = (string) $target['_id'];

        echo "\n  Publishing to " . $platform . ' (account ' . $postId . ") — a real post.\n";

        $postResponse = zernioCall(
            $client,
            'POST',
            '/posts',
            $options['key'],
            $options['baseUrl'],
            [],
            [
                'platforms' => [['platform' => $platform, 'accountId' => $postId]],
                'content'   => $options['content'],
                'publishNow' => true,
            ],
            ['Idempotency-Key' => sprintf('spora-probe-%s', bin2hex(random_bytes(8)))],
        );

        echo '  Status: ' . $postResponse['status'] . "\n";

        $postMap = redactionMap([$postResponse['body']]);
        writeFixture($options['out'], 'create-post', $postResponse['body'], $postMap);

        $createdId = (string) ($postResponse['body']['post']['_id'] ?? '');

        if ($createdId !== '') {
            $analyticsResponse = zernioCall(
                $client,
                'GET',
                '/analytics',
                $options['key'],
                $options['baseUrl'],
                ['postId' => $createdId],
            );

            echo '  Analytics: ' . $analyticsResponse['status'] . "\n";

            $analyticsMap = redactionMap([$analyticsResponse['body']]);
            writeFixture($options['out'], 'analytics', $analyticsResponse['body'], $analyticsMap);

            echo "\n  Look at build/zernio-probe/redacted/analytics.json: does it carry a\n";
            echo "  number per network, or one aggregate for the post? That is the one\n";
            echo "  question the plugin's answer depends on.\n";
        }
    }
}

echo "\n";
echo '  The redacted files are the fixtures. Copy them into';
echo " tests/Fixtures/Zernio/ when the branch is ready for them.\n";
echo '  The raw files are yours and nobody else\'s — delete ' . $options['out'] . "/raw when you are done.\n";
echo "\n";
